#!/bin/sh
#==========================================================================
# Front bicolor LED (red/blue) indicator for HK1 RBOX X4 (Amlogic SC2).
#
#   red          : pre-boot / LED not driven yet (hardware default)
#   blue   (255) : system booted, no network
#   mixed  (128) : network available (has an IP, internet not required)
#
# "Network available" means: a default route exists, or an interface other
# than the box's own LAN bridge (br-lan) has a global IPv4 address.
#
# The single GPIO/PWM line drives a red/blue bicolor LED, so only the
# red:blue duty ratio can be changed (no true off state).
#==========================================================================

LED="/sys/class/leds/sys_led/brightness"
INTERVAL="10"

[ -w "${LED}" ] || exit 0

set_brightness() {
	[ "$(cat "${LED}" 2>/dev/null)" = "${1}" ] || echo "${1}" > "${LED}"
}

has_network() {
	# A default route means an uplink/WAN interface came up.
	ip route show default 2>/dev/null | grep -q . && return 0
	# Otherwise, an interface other than lo/br-lan carries a global IPv4.
	ip -4 -o addr show scope global 2>/dev/null | awk '{print $2}' \
		| grep -qvE '^(lo|br-lan)$' && return 0
	return 1
}

# Boot finished -> blue
set_brightness 255

while :; do
	if has_network; then
		set_brightness 128
	else
		set_brightness 255
	fi
	sleep "${INTERVAL}"
done
